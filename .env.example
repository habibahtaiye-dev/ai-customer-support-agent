# ─── Demo mode (no configuration needed) ───────────────────────────
# The app runs in demo mode by default with a built-in knowledge base
# and a rule-based answer composer. No environment variables are required
# to try the demo.

# ─── Optional: LLM provider (to replace demo-mode generation) ───────
# Uncomment and set these to use a real LLM for answer generation
# instead of the rule-based composer.

# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Optional: Supabase (for persistence in production) ─────────────
# A Supabase project may be provisioned automatically. These values
# are pre-populated when available and should not be hardcoded in code.

# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Optional: Retrieval backend ────────────────────────────────────
# To use embeddings-based retrieval instead of the built-in TF-cosine
# index, set the vector store provider and connection details.

# RETRIEVAL_PROVIDER=pgvector   # or "pinecone"
# VECTOR_DB_URL=postgresql://...
# EMBEDDINGS_PROVIDER=openai
